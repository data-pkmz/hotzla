datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  REQUESTER
  MANAGER
  WORKER
}

enum OrderStatus {
  PENDING_BUDGET
  BUDGET_APPROVED
  APPROVED_FOR_PRODUCTION
  IN_PRINTING
  READY_FOR_PICKUP
  COMPLETED
  REJECTED
}

enum ChangeSource {
  SYSTEM
  EMAIL_BUDGET_OFFICER
  MANAGER_UI
  WORKER_UI
}

enum ProductType {
  FIXED
  DYNAMIC
}

enum AttributeType {
  SELECT
  NUMBER
  BOOLEAN
  TEXT
  FILE_UPLOAD
}

enum PricingRule {
  NONE
  PER_UNIT_MULTIPLIER
  FLAT_ADD_PER_OPTION
}

enum PriceModifierType {
  FIXED_ADD
  MULTIPLY
}

enum Status {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum Direction {
  OUTBOUND
  INBOUND
}

enum ProcessedStatus {
  PENDING
  MATCHED
  IGNORED
  ERROR
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String?  @map("full_name")
  militaryEmail String?  @map("military_email")
  adUsername    String   @unique @map("ad_username")
  unit          String?
  phone         String?
  role          Role     @default(REQUESTER)
  createdAt     DateTime @default(now()) @map("created_at")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  statusHistoryEntries OrderStatusHistory[]
  productEntries Product[]
  cartEntries Cart[]
  orderRequesters Order[] @relation("orderRequester")
  orderApprovers Order[] @relation("orderApprover")
  orderWorkers Order[] @relation("orderWorker")

  @@map("users")
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  orders          Order        @relation(fields: [orderId], references:[id])
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  changedBySource ChangeSource @map("changed_by_source")
  changedAt       DateTime     @default(now()) @map("changed_at")
  note            String?      @db.Text
  isDeleted       Boolean      @default(false) @map("is_deleted")

  changedByUser User? @relation(fields: [changedByUserId], references: [id])

  @@map("order_status_history")
}

model Product {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  description   String
  category      String
  productType   ProductType  @map("product_type")
  basePrice     Decimal      @map("base_price")
  isActive      Boolean      @map("is_active")
  createdBy     String?      @map("created_by") @db.Uuid
  createdByUser User?        @relation(fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")
  isDeleted     Boolean      @default(false) @map("is_deleted")
  attributeDefinitionEntries ProductAttributeDefinition[]
  cartItemEntries CartItem[]
  orderItemEntries OrderItem[]
  @@map("products")
}

model ProductAttributeDefinition {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  product       Product       @relation(fields: [productId], references: [id])
  attributeName String        @map("attribute_name")
  attributeType AttributeType @map("attribute_type")
  isRequired    Boolean       @map("is_required")
  displayOrder  Int           @map("display_order")
  pricingRule   PricingRule   @map("pricing_rule")
  unitPrice     Decimal?      @map("unit_price")
  minValue      Decimal?      @map("min_value")
  maxValue      Decimal?      @map("max_value")
  isDeleted     Boolean       @default(false) @map("is_deleted")
  attributeOptionEntries ProductAttributeOption[]
  orderAttributeEntries OrderItemAttributeValue[]
  @@map("product_attribute_definition")
}

model ProductAttributeOption {
  id                      String                     @id @default(uuid()) @db.Uuid
  attributeDefinitionId   String                     @map("attribute_definition_id") @db.Uuid
  attributeDefinition     ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  optionLabel             String                     @map("option_label")
  optionValue             String                     @map("option_value")
  priceModifier           Decimal                    @map("price_modifier")
  priceModifierType       PriceModifierType          @map("price_modifier_type")
  displayOrder            Int                        @map("display_order")
  isDeleted               Boolean                    @default(false) @map("is_deleted")
  isPerUnit               Boolean                    @default(false) @map("is_per_unit")
  orderAttributeEntries OrderItemAttributeValue[]
  @@map("product_attribute_options")
}

model Cart {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  user              User           @relation(fields: [userId], references: [id])
  status            Status
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @map("updated_at")
  isDeleted         Boolean        @default(false) @map("is_deleted")
  cartItemEntries CartItem[]
  @@map("carts")
}

model CartItem {
  id                  String         @id @default(uuid()) @db.Uuid
  cartId              String         @map("cart_id") @db.Uuid
  cart                Cart           @relation(fields: [cartId], references: [id])
  productId           String         @map("product_id") @db.Uuid
  product             Product        @relation(fields: [productId], references: [id])
  uploadedFilePath    String         @map("uploaded_file_path")
  computedPrice       Decimal        @map("computed_price")
  selectedAttributes  Json           @map("selected_attributes")
  isDeleted           Boolean        @default(false) @map("is_deleted")
  @@map("cart_items")
}

model Order {
  id                  String         @id @default(uuid()) @db.Uuid
  orderNumber         String         @unique @map("order_number")
  requesterId         String         @map("requester_id") @db.Uuid
  requester           User           @relation("orderRequester", fields: [requesterId], references: [id])
  unit                String
  status              OrderStatus
  budgetOfficerName   String         @map("budget_officer_name")
  budgetOfficerEmail  String         @map("budget_officer_email")
  totalPrice          Decimal        @map("total_price")
  approvedByManagerId String?        @map("approved_by_manager_id") @db.Uuid
  approvedByManager   User?          @relation("orderApprover", fields: [approvedByManagerId], references: [id])
  approvedByManagerAt DateTime?      @map("approved_by_manager_at")
  workerId            String?        @map("worker_id") @db.Uuid
  worker              User?          @relation("orderWorker", fields: [workerId], references: [id])
  completedAt         DateTime?      @map("completed_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  isDeleted           Boolean        @default(false) @map("is_deleted")
  itemEntries OrderItem[]
  emailLogEntries EmailLog[]
  approvedTokenEntries ApprovalToken[]
  orderStatus OrderStatusHistory[]
  @@map("orders")
}

model OrderItem {
  id                   String         @id @default(uuid()) @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  order                Order          @relation(fields: [orderId], references: [id])
  productId            String         @map("product_id") @db.Uuid
  product              Product        @relation(fields: [productId], references: [id])
  uploadedFilePath     String         @map("uploaded_file_path")
  computedUnitPrice    Decimal        @map("computed_unit_price")
  computedTotalPrice   Decimal        @map("computed_total_price")
  isDeleted            Boolean        @default(false) @map("is_deleted")
  itemAttributeEntries OrderItemAttributeValue[]
  @@map("order_items")
}

model OrderItemAttributeValue {
  id                    String                     @id @default(uuid()) @db.Uuid
  orderItemId           String                     @map("order_item_id") @db.Uuid
  orderItem             OrderItem                  @relation(fields: [orderItemId], references: [id])
  attributeDefinitionId String                     @map("attribute_definition_id") @db.Uuid
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  selectedOptionId      String                     @map("selected_option_id") @db.Uuid
  selectedOption        ProductAttributeOption     @relation(fields: [selectedOptionId], references: [id])
  valueText             String                     @map("value_text")
  isDeleted             Boolean                    @default(false) @map("is_deleted")
  @@map("order_item_attribute_values")
}

model EmailLog {
  id                 String          @id @default(uuid()) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  order              Order           @relation(fields: [orderId], references: [id])
  direction          Direction 
  toAddress          String          @map("to_address")
  fromAddress        String          @map("from_address")
  subject            String 
  processedStatus    ProcessedStatus @map("processed_status")
  createdAt          DateTime        @default(now()) @map("created_at")
  isDeleted          Boolean         @default(false) @map("is_deleted")
  @@map("email_log")
}

model ApprovalToken {
  id                   String          @id @default(uuid()) @db.Uuid
  orderId              String          @map("order_id") @db.Uuid
  order                Order           @relation(fields: [orderId], references: [id])
  token                String          @unique
  isUsed               Boolean         @map("is_used")
  expiresAt            DateTime        @map("expires_at")
  usedAt               DateTime?       @map("used_at")    
  isDeleted            Boolean         @default(false) @map("is_deleted")
  @@map("approval_tokens")        
}