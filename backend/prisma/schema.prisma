datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  REQUESTER
  MANAGER
  WORKER
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name")
  militaryEmail String   @map("military_email")
  adUsername    String   @unique @map("ad_username")
  unit          String
  phone         String
  role          Role     @default(REQUESTER)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("users")
}
