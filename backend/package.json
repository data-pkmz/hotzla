    "imapflow": "1.7.8",
    "mailparser": "3.12.4",
    "multer": "2.5.0",
    "nodemailer": "9.1.1",
    "pg": "8.23.1",
    "shared-types": "*",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/mailparser": "3.9.0",
    "@types/multer": "2.3.0",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node-dev": "2.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
