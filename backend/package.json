{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "build": "prisma generate && tsc -b",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma db seed",
